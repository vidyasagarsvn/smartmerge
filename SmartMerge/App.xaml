<Application x:Class="SmartMerge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Theme Resources -->
            <Color x:Key="PrimaryColor">#007ACC</Color>
            <Color x:Key="SecondaryColor">#F3F3F3</Color>
            <Color x:Key="DarkBackgroundColor">#252526</Color>
            <Color x:Key="LightTextColor">#FFFFFF</Color>
            <Color x:Key="DarkTextColor">#1E1E1E</Color>
            
            <!-- Diff Colors -->
            <Color x:Key="AddedLineColor">#E2FFE2</Color>
            <Color x:Key="RemovedLineColor">#FFE2E2</Color>
            <Color x:Key="ModifiedLineColor">#E2E6FF</Color>
            <Color x:Key="ConflictLineColor">#FFE2B6</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
