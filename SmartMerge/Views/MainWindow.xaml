<Window x:Class="SmartMerge.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmartMerge.ViewModels"
        xmlns:views="clr-namespace:SmartMerge.Views"
        Title="SmartMerge - File &amp; Folder Compare"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="views:FileCompareView">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:AppView.FileCompare}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="views:FolderCompareView">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:AppView.FolderCompare}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFilesCommand}" />
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OpenFoldersCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAllCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FindCommand}" />
        <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding FontCommand}" />
        <KeyBinding Key="G" Modifiers="Control" Command="{Binding GoToLineCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding PrevCommand}" />
        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding NextCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding CopyRightToLeftCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding CopyLeftToRightCommand}" />
        <KeyBinding Key="Left" Modifiers="Control+Alt" Command="{Binding CopyAllRightToLeftCommand}" />
        <KeyBinding Key="Right" Modifiers="Control+Alt" Command="{Binding CopyAllLeftToRightCommand}" />
        <KeyBinding Key="Escape" Command="{Binding BackToFolderCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{DynamicResource MenuBackgroundBrush}" Foreground="{DynamicResource MenuForegroundBrush}" Height="30">
            <MenuItem Header="_File">
                <MenuItem Header="Open Files..." InputGestureText="Ctrl+O" Command="{Binding OpenFilesCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconOpenFiles}" Width="14" Height="14" Opacity="0.85" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open Folders..." InputGestureText="Ctrl+Shift+O" Command="{Binding OpenFoldersCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconOpenFolders}" Width="14" Height="14" Opacity="0.85" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Back to Folder View" InputGestureText="Esc" Command="{Binding BackToFolderCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconBack}" Width="14" Height="14" Opacity="0.85" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconExit}" Width="14" Height="14" Opacity="0.85" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconUndo}" Width="14" Height="14" Opacity="0.85" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Redo" InputGestureText="Ctrl+Shift+Z" Command="{Binding RedoCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconRedo}" Width="14" Height="14" Opacity="0.85" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconSave}" Width="14" Height="14" Opacity="0.85" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save All" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAllCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconSave}" Width="14" Height="14" Opacity="0.6" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Find..." InputGestureText="Ctrl+F" Command="{Binding FindCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconFind}" Width="14" Height="14" Opacity="0.85" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Font..." InputGestureText="Ctrl+Shift+F" Command="{Binding FontCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconGoToLine}" Width="14" Height="14" Opacity="0.6" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Go to Line..." InputGestureText="Ctrl+G" Command="{Binding GoToLineCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconGoToLine}" Width="14" Height="14" Opacity="0.85" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Navigate">
                <MenuItem Header="Previous Change" InputGestureText="Alt+Up" Command="{Binding PrevCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconPrev}" Width="14" Height="14" Opacity="0.85" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Next Change" InputGestureText="Alt+Down" Command="{Binding NextCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconNext}" Width="14" Height="14" Opacity="0.85" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Merge">
                <MenuItem Header="Copy Left to Right" InputGestureText="Alt+Right" Command="{Binding CopyLeftToRightCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconCopyRight}" Width="14" Height="14" Opacity="0.85" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Copy Right to Left" InputGestureText="Alt+Left" Command="{Binding CopyRightToLeftCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconCopyLeft}" Width="14" Height="14" Opacity="0.85" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Copy All Left to Right" InputGestureText="Ctrl+Alt+Right" Command="{Binding CopyAllLeftToRightCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconCopyAllRight}" Width="14" Height="14" Opacity="0.85" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Copy All Right to Left" InputGestureText="Ctrl+Alt+Left" Command="{Binding CopyAllRightToLeftCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconCopyAllLeft}" Width="14" Height="14" Opacity="0.85" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="Engine">
                    <MenuItem Header="Myers Diff" IsCheckable="True" IsChecked="{Binding IsMyersEngine, Mode=OneWay}" Command="{Binding UseMyersCommand}" />
                    <MenuItem Header="Smart Block Diff" IsCheckable="True" IsChecked="{Binding IsSmartEngine, Mode=OneWay}" Command="{Binding UseSmartCommand}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About SmartMerge" Command="{Binding AboutCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconAbout}" Width="14" Height="14" Opacity="0.85" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackgroundBrush}">
            <ToolBar Background="{DynamicResource ToolbarBackgroundBrush}" Band="0" BandIndex="0">
                <Button Command="{Binding OpenFilesCommand}" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconOpenFiles}" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="Open Files" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenFoldersCommand}" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconOpenFolders}" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="Open Folders" />
                    </StackPanel>
                </Button>
                <Separator Background="{DynamicResource ToolbarSeparatorBrush}" />
                <Button Command="{Binding SaveCommand}" Margin="6,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconSave}" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding FindCommand}" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconFind}" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="Find" />
                    </StackPanel>
                </Button>
                <Separator Background="{DynamicResource ToolbarSeparatorBrush}" />
                <Button Command="{Binding PrevCommand}" Margin="6,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconPrev}" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="Prev" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding NextCommand}" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconNext}" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="Next" />
                    </StackPanel>
                </Button>
                <Separator Background="{DynamicResource ToolbarSeparatorBrush}" />
                <Button Command="{Binding CopyLeftToRightCommand}" Margin="6,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconCopyRight}" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="Copy" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CopyRightToLeftCommand}" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconCopyLeft}" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="Copy" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CopyAllLeftToRightCommand}" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconCopyAllRight}" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="All" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CopyAllRightToLeftCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconCopyAllLeft}" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="All" />
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource ToolbarBackgroundBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SubtleTextBrush}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Background="{DynamicResource AppBackgroundBrush}">
            <views:FileCompareView x:Name="FileCompareViewControl"
                                                                     DataContext="{Binding FileCompare}" />
            <views:FolderCompareView x:Name="FolderCompareViewControl"
                                                                         DataContext="{Binding FolderCompare}" />
        </Grid>
    </DockPanel>
</Window>
