<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#FFFFFF</Color>
    <Color x:Key="PanelBackgroundColor">#FFFFFF</Color>
    <Color x:Key="PanelBorderColor">#D1D5DB</Color>
    <Color x:Key="HeaderBackgroundColor">#F3F4F6</Color>
    <Color x:Key="HeaderForegroundColor">#374151</Color>
    <Color x:Key="ToolbarBackgroundColor">#F5F5F5</Color>
    <Color x:Key="ToolbarSeparatorColor">#D0D0D0</Color>
    <Color x:Key="MenuBackgroundColor">#F5F5F5</Color>
    <Color x:Key="MenuForegroundColor">#000000</Color>
    <Color x:Key="MenuHighlightColor">#E8E8E8</Color>
    <Color x:Key="LineNumberBackgroundColor">#F3F4F6</Color>
    <Color x:Key="LineNumberForegroundColor">#6B7280</Color>
    <Color x:Key="TextForegroundColor">#111827</Color>
    <Color x:Key="SubtleTextColor">#6B7280</Color>

    <Color x:Key="DiffAddedColor">#DCFCE7</Color>
    <Color x:Key="DiffRemovedColor">#FEE2E2</Color>
    <Color x:Key="DiffModifiedColor">#FEF3C7</Color>

    <Color x:Key="RegionHighlightColor">#BFDBFE</Color>
    <Color x:Key="SearchHighlightColor">#FDE68A</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorderColor}" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource HeaderBackgroundColor}" />
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="{StaticResource HeaderForegroundColor}" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="{StaticResource ToolbarBackgroundColor}" />
    <SolidColorBrush x:Key="ToolbarSeparatorBrush" Color="{StaticResource ToolbarSeparatorColor}" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="{StaticResource MenuBackgroundColor}" />
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="{StaticResource MenuForegroundColor}" />
    <SolidColorBrush x:Key="MenuHighlightBrush" Color="{StaticResource MenuHighlightColor}" />
    <SolidColorBrush x:Key="LineNumberBackgroundBrush" Color="{StaticResource LineNumberBackgroundColor}" />
    <SolidColorBrush x:Key="LineNumberForegroundBrush" Color="{StaticResource LineNumberForegroundColor}" />
    <SolidColorBrush x:Key="TextForegroundBrush" Color="{StaticResource TextForegroundColor}" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="{StaticResource SubtleTextColor}" />

    <SolidColorBrush x:Key="DiffAddedBrush" Color="{StaticResource DiffAddedColor}" />
    <SolidColorBrush x:Key="DiffRemovedBrush" Color="{StaticResource DiffRemovedColor}" />
    <SolidColorBrush x:Key="DiffModifiedBrush" Color="{StaticResource DiffModifiedColor}" />

    <SolidColorBrush x:Key="RegionHighlightBrush" Color="{StaticResource RegionHighlightColor}" />
    <SolidColorBrush x:Key="SearchHighlightBrush" Color="{StaticResource SearchHighlightColor}" />
</ResourceDictionary>
